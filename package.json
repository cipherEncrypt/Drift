{
  "name": "drift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name drift --commit-dirty=true",
    "deploy:vercel": "npm run build && vercel deploy dist --prod --yes",
    "deploy": "npm run deploy:pages"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
